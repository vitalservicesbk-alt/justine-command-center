{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "justine-command-center",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-luna"
  },
  "observability": {
    "enabled": true
  }
}
